        <mxCell id="uvQYUA6P2yuay3lXrDvk-118" parent="uvQYUA6P2yuay3lXrDvk-115" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;FLASH_CREDS page 21&lt;/b&gt;&lt;br&gt;plaintext packed&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;· SAE CA DER — provision peer verify&lt;br&gt;· device ML-DSA-44 cert DER — mTLS client cert&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
