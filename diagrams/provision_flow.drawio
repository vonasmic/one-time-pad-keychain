        </mxCell>
        <mxCell id="gen" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" value="No shared keys were found for this pair.&lt;br&gt;Generate new keys now?&lt;br&gt;(skipped after a delete)" vertex="1">
          <mxGeometry height="150" width="380" x="20" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="lock" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;fontSize=13;" value="Lock the pair: lower SAE ID first,&lt;br&gt;then higher" vertex="1">
