<mxCell id="select" value="Operator: choose peer SAE and peer device&lt;br&gt;(InputHandler.selectForUplink)&lt;br&gt;pad_plain = min(plainMax, peer pad_plain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="740" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="sync" value="Local synchronize()&lt;br&gt;(AtomicRecordStateMap)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="790" y="850" width="360" height="130" as="geometry"/></mxCell>
<mxCell id="busy" value="NOT_INSERTED: Record sharing is in&lt;br&gt;progress on another SAE. Wait 10 s, retry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="885" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="rules" value="&lt;b&gt;synchronize() eligibility&lt;/b&gt; (window 5 min)&lt;br&gt;&lt;b&gt;INSERTED&lt;/b&gt;: no row or retention expired; stale RECORD_SYNCHRONIZATION, RECORD_FETCHING_STARTED or RECORD_SHARED; RECORD_SYNCHRONIZATION of the same issuer, or the issuer ID is higher than this SAE ID&lt;br&gt;&lt;b&gt;ORIGIN_PROVISIONED&lt;/b&gt;: finished row, same target SAE&lt;br&gt;&lt;b&gt;RECORD_SHARED_WITH_DIFFERENT_SAE&lt;/b&gt;: RECORD_SHARED, ORIGIN_PROVISIONED or a live RECORD_SYNCHRONIZATION for a different target SAE&lt;br&gt;&lt;b&gt;NOT_INSERTED&lt;/b&gt;: fresh RECORD_FETCHING_STARTED; for the same target SAE a fresh RECORD_SHARED or a live RECORD_SYNCHRONIZATION of another issuer&lt;br&gt;&lt;b&gt;Lifecycle&lt;/b&gt;: RECORD_SYNCHRONIZATION → RECORD_FETCHING_STARTED → RECORD_SHARED → ORIGIN_PROVISIONED&lt;br&gt;&lt;b&gt;RMI&lt;/b&gt;: every call is mTLS with a pinned peer SPKI; issuingSaeId must be the caller; removeRecord / markOriginProvisioned only by a party; deleteShare by a non-party only for a completed share (handover)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="520" height="330" as="geometry"/></mxCell>
<mxCell id="gen" value="No shared keys were found for this pair.&lt;br&gt;Generate new keys now?&lt;br&gt;(skipped after a delete)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1070" width="380" height="150" as="geometry"/></mxCell>
<mxCell id="psync" value="RMI synchronize() on peer SAE&lt;br&gt;(reversed hashes) → RECORD_SYNCHRONIZATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="340" height="70" as="geometry"/></mxCell>
<mxCell id="pout" value="Peer outcome?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="340" height="120" as="geometry"/></mxCell>
<mxCell id="rej" value="Rollback origin row. Target SAE&lt;br&gt;rejected the insert; retry later." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="1530" width="280" height="70" as="geometry"/></mxCell>
<mxCell id="pdel" value="getRecordMetadata() on peer.&lt;br&gt;This will permanently delete&lt;br&gt;those keys. Delete them and&lt;br&gt;generate new ones?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1230" width="300" height="150" as="geometry"/></mxCell>
