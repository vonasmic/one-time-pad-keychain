  <diagram name="ENCRYPT / DECRYPT" id="EncryptDecryptFlow001">
    <mxGraphModel dx="1557" dy="1103" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="edf-note-ok" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="&lt;b&gt;This order establishes:&lt;/b&gt;&lt;br&gt;- Pads stay sealed until owner-authenticated TLS and a live PIN&lt;br&gt;- A wrong PIN spends a chip try before the secret is checked&lt;br&gt;- Pad keys exist only after KEM decapsulation; the secret key is gone before XOR&lt;br&gt;- Pad keys also need the device fill identity&lt;br&gt;- Device and chip cursors must agree; they never rewind&lt;br&gt;- Used or skipped pads are erased&lt;br&gt;- A bad pad tag yields no output and does not move the cursor" vertex="1">
          <mxGeometry height="230" width="380" x="30" y="370" as="geometry" />
        </mxCell>
        <mxCell id="edf-note-limits" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="&lt;b&gt;Out of scope for this figure:&lt;/b&gt;&lt;br&gt;- The host app sees the PIN on TLS&lt;br&gt;- Power, timing, and fault attacks&lt;br&gt;- A dump of the device key still needs the PIN and a remaining chip try" vertex="1">
          <mxGeometry height="120" width="380" x="30" y="620" as="geometry" />
        </mxCell>
