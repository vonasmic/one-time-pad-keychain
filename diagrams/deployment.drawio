        <mxCell id="sSame" parent="sae" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eaf7;strokeColor=#9673a6;fontSize=14;dashed=1;" value="&lt;b&gt;Second SAE&lt;/b&gt;&lt;br&gt;The same design.&lt;br&gt;Own identity, database, and KME." vertex="1">
          <mxGeometry height="100" width="360" x="620" y="204" as="geometry" />
