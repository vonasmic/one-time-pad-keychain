# HSM env — shared Utimaco connection (not per-node). Copy to env/hsm.env.
# Source together with a node/terminal env file before running mvn exec:java
# (also export before CertGenerator).
# Do not commit real PINs.
HSM_DEVICE=3001@127.0.0.1
HSM_TIMEOUT_MS=60000
HSM_USER=CXI_HMAC
# Secret — leave unset in production (stdin prompt). Lab simulator only if set:
HSM_PIN=12345678
HSM_MLDSA_GROUP=JAVA_APPS
HSM_MLDSA_SPEC=0
