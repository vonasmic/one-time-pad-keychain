# Copy to .env or env/node-N.env and adjust paths/URLs.
# Run from JAVA_APPS (working directory must contain certs/).
#
# IntelliJ: Run → Edit Configurations → Environment variables → load this file
#            (EnvFile plugin) or paste variables manually.

# Database (required — one SQLite file per node, e.g. data/qkd-sae-1.db for node 1)
# File is created with mode 0600 on first open if missing.
# Run migrations manually before starting a node:
#   ./migrate.sh              # uses .env
#   ./migrate.sh env/node-1.env
#   ./migrate-all.sh          # all env/node-*.env
DB_URL=jdbc:sqlite:data/qkd-sae-1.db

# Required. SAE_ID selects this node's entry in SAE_NODES_FILE, which gives its name
# (HSM key + leaf cert), advertised hostname and RMI registry port.
SAE_ID=sae-1
USB_SERIAL_PORT=auto
QKD_BASE_URL=https://kme-1.acct-your-account-id-here.etsi-qkd-api.qukaydee.com

# QKD mTLS at runtime (HSM alias + KME server CA truststore; provision keys via CertGenerator)
QKD_HSM_KEY_ALIAS=sae-1
QKD_TRUSTSTORE_PATH=certs/qkd/qkd-server-ca.p12
# Secret — leave unset in production (masked terminal prompt; also accepts QKD_KEYSTORE_PASSWORD).
# Lab only if set:
QKD_TRUSTSTORE_PASSWORD=password

# HSM connection: env/hsm.env — source it together with this file (see modules/sae-node/README.md)
# HSM_PIN is a secret in hsm.env — leave unset in production (masked terminal prompt).

# SAE directory (required): JSON list, one entry per SAE, identical at every site
# [{"saeId","name","location","hostname","port","spkiSha384"}]. name selects the HSM key
# {HSM_MLDSA_GROUP}/{name} and certs/{name}.pem; spkiSha384 is the SHA-384 hex of that
# leaf's SubjectPublicKeyInfo and pins the SAE for RMI. The node refuses a file that is
# group- or other-writable and checks its own pin against its leaf. In the lab,
# scripts/java.sh certgen / node / lab-node fill the pins (scripts/rmi-pins.py).
SAE_NODES_FILE=env/sae-nodes.json

# Optional (defaults shown)
# NODE_RMI_BIND=127.0.0.1   # local RMI bind address (default: own entry's hostname)
# USB_SERIAL_PORT=auto
# USB_BAUD_RATE=115200
# none / off / disabled skips CDC (RMI only)
# USB_LAB_FILE and USB_LAB_CLIENT are set by scripts/java.sh lab-node, not here.
# PQC_CERTS_DIR=certs
# Daily in-process record retention + refuse-to-serve older rows (Node thread)
# RECORD_RETENTION_DAYS=14

# FULL sends logs and library prints to stderr. TERMINAL (default, also when
# unset) prints operator text plus SEVERE lines on stderr. INFO and WARNING
# stay in SQLite only. SQLite application_log is written in both modes.
# APP_LOG=TERMINAL
