<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fel.cvut</groupId>
        <artifactId>java-tls-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>tls-hsm</artifactId>
    <dependencies>
        <dependency>
            <groupId>fel.cvut</groupId>
            <artifactId>tls-software</artifactId>
        </dependency>
        <dependency>
            <groupId>fel.cvut</groupId>
            <artifactId>se-wire</artifactId>
        </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bctls-jdk18on</artifactId>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
            </dependency>
        <dependency>
            <groupId>de.utimaco</groupId>
            <artifactId>cryptoservercxi</artifactId>
            <version>local</version>
            <scope>system</scope>
            <systemPath>${maven.multiModuleProjectDirectory}/vendor/cryptoservercxi.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>de.utimaco</groupId>
            <artifactId>securityserver-jce</artifactId>
            <version>local</version>
            <scope>system</scope>
            <systemPath>${maven.multiModuleProjectDirectory}/vendor/securityserver-jce.jar</systemPath>
        </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <scope>test</scope>
            </dependency>
    </dependencies>
    <build>
        <sourceDirectory>${src.root}/SaeNode/main/java</sourceDirectory>
        <testSourceDirectory>${src.root}/SaeNode/test/java</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>pqmi-java</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${maven.multiModuleProjectDirectory}/vendor/pqmi-java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>fel/cvut/tls/HsmNodeTls.java</include>
                        <include>fel/cvut/tls/TlsProviders.java</include>
                        <include>fel/cvut/utimaco/**</include>
                        <include>com/utimaco/**</include>
                    </includes>
                    <testIncludes>
                        <testInclude>fel/cvut/utimaco/HsmLiveNoFallbackTest.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
