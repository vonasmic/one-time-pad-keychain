# Copy to env/userapp.env (optional). Source before mvn exec:java.
# Run from JAVA_TLS_TEST (working directory must contain certs/).
# See src/UserApp/README.md.
#
# UserApp does not use the HSM. Owner identity is certs/user/user.p12
# (PEM fallback: user-cert.pem + user-key.pem). Device cert is installed
# from CLIENT CSR (INIT LAB signs it; INIT PROD does not).
# lab-run.py overwrites USERAPP_DEVICE_CERT when CL 1 / CL 2 changes.

USB_SERIAL_PORT=/tmp/ttyACM-se1
# USB_BAUD_RATE=115200

# Owner TLS identity (MANAGE / ENCRYPT / DECRYPT)
USERAPP_OWNER_P12=user/user.p12
# USERAPP_OWNER_P12_PASSWORD=password
USERAPP_OWNER_CERT=user/user-cert.pem
USERAPP_OWNER_KEY=user/user-key.pem

# Signed device leaf (INIT LAB writes this; INIT PROD installs it if present)
USERAPP_DEVICE_CERT=client/client-cert.pem
USERAPP_CLIENT_CA_P12=ca/client_ca.p12

# SAE root CA imported into the chip (required)
USERAPP_SAE_CA=ca/root-ca.pem
