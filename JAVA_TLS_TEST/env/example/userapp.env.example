# Copy to env/userapp.env (optional). Source before mvn exec:java.
# Run from JAVA_TLS_TEST (working directory must contain certs/).
# See src/UserApp/README.md.
#
# UserApp does not use the HSM. Owner identity is certs/user/*.pem;
# device creds for INIT/OWNER SET come from USERAPP_DEVICE_* below.
# lab-run.py overwrites USERAPP_DEVICE_* when CL 1 / CL 2 changes.

USB_SERIAL_PORT=/tmp/ttyACM-se1
# USB_BAUD_RATE=115200

# Owner TLS identity (MANAGE / ENCRYPT / DECRYPT)
USERAPP_OWNER_CERT=user/user-cert.pem
USERAPP_OWNER_KEY=user/user-key.pem

# Device creds written into the chip during INIT / OWNER SET (client 1 default)
USERAPP_DEVICE_CERT=client/client-cert.pem
USERAPP_DEVICE_KEY=client/client-key.pem
# Host backup of Tropic pairing X25519 (written by INIT). Default: same folder as the device cert.
# USERAPP_PAIRING_KEY=client/pairing.key

# SAE root CA imported into the chip (required)
USERAPP_SAE_CA=ca/root-ca.pem
