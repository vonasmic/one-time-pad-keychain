# Copy to env/certgen.env. CertGenerator reads this file from JAVA_TLS_TEST
# (or CERTGEN_ENV). HSM connection still comes from env/hsm.env — source that
# before running mvn exec:java. See src/CertGenerator/README.md.
#
# Names are basenames (no path, no .pem suffix).
# CAs go in certs/ca/; node leaves stay as certs/{Name}.pem; clients in certs/client|client2|user/.

# SAE trust anchor → certs/ca/{name}.p12 + .pem
CERTGEN_ROOT_CA=root-ca

# Client-auth CA for device / user leaves → certs/ca/{name}.p12 + .pem
CERTGEN_CLIENT_CA=client_ca

# Node leaf CNs / HSM key names / certs/{Name}.pem (comma-separated).
# Missing HSM keys are generated in PQMI; missing PEMs are issued from the HSM public key.
CERTGEN_NODES=Alice,Bob,Carol,Terminal

# Software ML-DSA client leaves (comma-separated CNs). Missing bundles only.
#   native-tls-client   → certs/client/{client-cert.pem,client-key.pem}   (se-host-1 / silicon)
#   native-tls-client-2 → certs/client2/{client-cert.pem,client-key.pem}  (se-host-2)
#   otp-user            → certs/user/{user-cert.pem,user-key.pem}         (trusts certs/ca/client_ca.pem)
#   any other name      → certs/clients/{name}/{name}-cert.pem, {name}-key.pem
CERTGEN_CLIENTS=native-tls-client,native-tls-client-2,otp-user

# QuKayDee SAE keys: CertGenerator also imports any certs/qkd/*-client.p12 that is
# not already in CryptoServer (PKCS#12 password "password"). It does not generate
# those keys in the HSM.
