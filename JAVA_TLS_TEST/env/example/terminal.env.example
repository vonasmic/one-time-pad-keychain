# Copy to env/terminal-N.env and adjust to match the node you want to operate.
# Run from JAVA_TLS_TEST (working directory must contain certs/).
# See src/TerminalBridge/README.md.
#
# Provision the terminal's own HSM identity first (CertGenerator), e.g. certs/Terminal.pem.

# HSM key + leaf cert selector for this terminal app's identity
# (key: {HSM_MLDSA_GROUP}/Terminal, cert: certs/Terminal.pem)
# HSM connection: env/hsm.env — source it together with this file before running mvn exec:java
TLS_NODE_ID=Terminal

NODE_HOSTNAME=127.0.0.1
NODE_TERMINAL_PORT=11112
USB_BRIDGE=1
NODE_NATIVE_PORT=11111
USB_SERIAL_PORT=/tmp/ttyACM-se1
# USB_BAUD_RATE=115200
