# Copy to .env or env/node-N.env and adjust paths/URLs.
# Run from JAVA_TLS_TEST (working directory must contain certs/).
#
# IntelliJ: Run → Edit Configurations → Environment variables → load this file
#            (EnvFile plugin) or paste variables manually.
#
# JVM option (not read from env): -Djava.library.path=src/main/native_tls

# Database (required — one DB per node, e.g. qkd-db-sae-1 for node 1)
# Run migrations manually before starting a node:
#   ./migrate.sh              # uses .env
#   ./migrate.sh env/node-1.env
#   ./migrate-all.sh          # all env/*.env
DB_URL=jdbc:postgresql://localhost:5432/qkd-db-sae-1
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Required
SAE_ID=sae-1
NODE_RMI_PORT=2010
NODE_NATIVE_PORT=11111
QKD_BASE_URL=https://kme-1.acct-your-account-id-here.etsi-qkd-api.qukaydee.com
TLS_NODE_ID=Alice

# Optional (defaults shown)
NODE_HOSTNAME=127.0.0.1
PQC_KEYSTORE_PATH=certs/Alice.p12
PQC_TRUSTSTORE_PATH=certs/root-ca.p12
PQC_KEYSTORE_PASSWORD=password
# PQC_CERTS_DIR=certs

# QuKayDee QKD mTLS (separate from PQC RMI certs above; see certs/qkd/README.md)
QKD_CLIENT_KEYSTORE_PATH=certs/qkd/sae-1-client.p12
QKD_TRUSTSTORE_PATH=certs/qkd/qkd-server-ca.p12
QKD_KEYSTORE_PASSWORD=password
